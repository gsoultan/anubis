# Anubis runtime configuration. Installed to /etc/anubis/anubisd.env.
#
# The MASTER KEY IS NOT HERE ON PURPOSE. It is passed as a systemd credential
# from /etc/anubis/secrets/master.key — see anubisd.service. An environment
# file is readable by anything running as this user and survives in core
# dumps; the key that unseals every signing key and every PII key does not
# belong in one.
#
# Generate one:  head -c 32 /dev/urandom | basenc --base64url | tr -d '='

# Required. The runtime connects as anubis_app (migrations/0023), NOT as the
# owner: the runtime must not be able to ALTER its own schema.
ANUBIS_DB_URL=postgres://anubis_app:CHANGE_ME@127.0.0.1:5432/anubis?sslmode=require

# First install only, after `anubisd migrate`:
#     anubisd keys init access
# Without a signing key /readyz is 503 and no token can be issued.
#
# Required in production, and it must match what every SDK verifies as `iss`.
# Getting this wrong makes every token fail verification in a way that looks
# like a key problem.
ANUBIS_ISSUER=https://auth.example.com

# `prod` refuses to boot without a master key, and refuses the dev shortcuts.
ANUBIS_ENV=prod

ANUBIS_LISTEN=:7448

# Metrics and pprof. LOOPBACK ONLY — these describe the installation's
# operation and belong to the operator, not the internet.
ANUBIS_DEBUG_LISTEN=127.0.0.1:7449

# Size to the DATABASE's capacity, not the app's ambition. One instance
# saturates near 11.8k decisions/s; past that, add a host rather than
# connections (docs/operations.md#performance-budgets).
# ANUBIS_DB_MAX_CONNS=32

# Past this age the gate fails closed AND /readyz fails, so the host leaves
# the load balancer instead of denying traffic it should allow.
# ANUBIS_SNAPSHOT_MAX_AGE=5m

# Must be shorter than the unit's TimeoutStopSec.
# ANUBIS_SHUTDOWN_GRACE=20s
